{
  "name": "Быстрый выбор и использование реквизита и ТЧ: булево true/false → Use/DontUse, значения по контексту реквизита",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": {
        "type": "Catalog",
        "name": "Номенклатура",
        "hierarchical": true,
        "attributes": [
          "Артикул: String(25)",
          "Вид: String(10)",
          "Цена: Number(15,2)"
        ],
        "tabularSections": {
          "Штрихкоды": [
            "Штрихкод: String(50)"
          ]
        }
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    }
  ],
  "params": {
    "objectPath": "Catalogs/Номенклатура"
  },
  "input": {
    "modify": {
      "attributes": {
        "Артикул": {
          "quickChoice": true,
          "use": "ForFolderAndItem"
        },
        "Вид": {
          "quickChoice": "auto"
        },
        "Цена": {
          "quickChoice": false
        }
      },
      "tabularSections": {
        "Штрихкоды": {
          "use": "ForFolder"
        }
      }
    }
  },
  "expect": {
    "fileContains": [
      {
        "file": "Catalogs/Номенклатура.xml",
        "text": [
          "<QuickChoice>DontUse</QuickChoice>",
          "<QuickChoice>Use</QuickChoice>",
          "<Use>ForFolderAndItem</Use>",
          "<Use>ForFolder</Use>"
        ]
      }
    ]
  }
}
