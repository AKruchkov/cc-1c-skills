{
  "name": "HTML-макет: добавление страницы на втором языке",
  "preRun": [
    {
      "script": "epf-init/scripts/init",
      "args": { "-Name": "МояОбработка", "-SrcDir": "{workDir}" }
    },
    {
      "script": "template-add/scripts/add-template",
      "args": {
        "-ObjectName": "МояОбработка",
        "-TemplateName": "МакетHTML",
        "-TemplateType": "HTML",
        "-SrcDir": "{workDir}"
      }
    }
  ],
  "params": { "objectName": "МояОбработка", "templateName": "МакетHTML", "templateType": "HTML" },
  "args_extra": ["-Lang", "en"],
  "expect": {
    "stdoutContains": ["Добавлена страница макета", "en.html"],
    "fileContains": {
      "file": "МояОбработка/Templates/МакетHTML/Ext/Template.xml",
      "text": "<Page>en</Page>\r\n\t<Page>ru</Page>"
    },
    "preserves": [
      {
        "file": "МояОбработка/Templates/МакетHTML/Ext/Template.xml",
        "bom": true,
        "eol": "crlf",
        "encoding": "UTF-8",
        "finalNewline": false,
        "noCR13": true
      },
      {
        "file": "МояОбработка/Templates/МакетHTML/Ext/Template/en.html",
        "bom": true,
        "eol": "lf",
        "finalNewline": false
      }
    ]
  }
}
