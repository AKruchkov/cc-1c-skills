{
  "name": "add-conditionalAppearance при order и outputParameters — до outputParameters",
  "preRun": [
    {
      "script": "skd-compile/scripts/skd-compile",
      "input": {
        "dataSets": [
          {
            "name": "Основной",
            "query": "ВЫБРАТЬ Т.Вид, Т.Сумма ИЗ Регистр КАК Т",
            "fields": [
              "Вид: decimal(1)",
              "Сумма: decimal(15,2)"
            ]
          }
        ],
        "settingsVariants": [
          {
            "name": "Основной",
            "settings": {
              "selection": [
                "Сумма"
              ],
              "order": [
                "Сумма desc"
              ],
              "outputParameters": {
                "Заголовок": "Отчёт"
              },
              "structure": "details"
            }
          }
        ]
      },
      "args": {
        "-DefinitionFile": "{inputFile}",
        "-OutputPath": "{workDir}/Template.xml"
      }
    }
  ],
  "params": {
    "templatePath": "Template.xml",
    "operation": "add-conditionalAppearance",
    "value": "ЦветТекста = web:Red when Сумма < 0"
  }
}
