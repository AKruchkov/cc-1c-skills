{
  "name": "Явно заданные selection/structure не достраиваются и не дают подсказок",
  "params": { "outputPath": "Template.xml" },
  "input": { "dataSets": [ { "name": "Набор", "query": "ВЫБРАТЬ 1 КАК Номер, \"а\" КАК Имя", "fields": ["Номер: decimal(10)", "Имя: string(10)"] } ], "settingsVariants": [ { "name": "АвтоВКорне", "settings": { "selection": ["Auto"], "structure": "details" } }, { "name": "ПоляВГруппе", "settings": { "structure": [ { "groupBy": ["Имя"], "selection": ["Номер"], "children": [ { "groupBy": [] } ] } ] } }, { "name": "ПустойВыборГруппы", "settings": { "structure": [ { "groupBy": ["Имя"], "selection": [] } ] } } ] },
  "validatePath": "Template.xml",
  "expect": {
    "files": ["Template.xml"],
    "stdoutNotContains": ["[INFO]", "[WARN]"],
    "preserves": { "file": "Template.xml", "bom": true, "eol": "crlf", "encoding": "UTF-8", "finalNewline": false, "noCR13": true, "selfClose": "tight", "noEmptyPairs": true }
  }
}
