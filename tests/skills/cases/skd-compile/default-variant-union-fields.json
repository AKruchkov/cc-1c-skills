{
  "name": "Объединение без своих полей — в вариант по умолчанию идут поля его частей",
  "params": { "outputPath": "Template.xml" },
  "input": { "dataSets": [ { "name": "Объед", "items": [ { "name": "Ч1", "query": "ВЫБРАТЬ 1 КАК А, 2 КАК Б", "fields": ["А", "Б"] }, { "name": "Ч2", "query": "ВЫБРАТЬ 1 КАК А, 3 КАК В", "fields": ["А", "В"] } ] } ] },
  "validatePath": "Template.xml",
  "expect": {
    "files": ["Template.xml"],
    "stdoutContains": "Выбранные поля — А, Б, В; структура — детальные записи (details).",
    "preserves": { "file": "Template.xml", "bom": true, "eol": "crlf", "encoding": "UTF-8", "finalNewline": false, "noCR13": true, "selfClose": "tight", "noEmptyPairs": true }
  }
}
