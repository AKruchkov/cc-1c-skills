        ],
        "attributes": [
          {
            "name": "Список",
            "type": "DynamicList",
            "main": true,
            "settings": {
              "mainTable": "Document.Расход",
              "query": "ВЫБРАТЬ Д.Ссылка КАК Ссылка, Т.Количество КАК Поле ИЗ Документ.Расход КАК Д ЛЕВОЕ СОЕДИНЕНИЕ Документ.Расход.Товары КАК Т ПО Т.Ссылка = Д.Ссылка"
            }
