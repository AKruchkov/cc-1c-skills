{
  "name": "Тильда у полей динамического списка — только когда запрос не разрешится в расширении",
  "preRun": [
    {
      "script": "meta-compile/scripts/meta-compile",
      "input": [
        {
          "type": "Catalog",
          "name": "Контрагенты",
          "hierarchical": true,
          "attributes": [
            "ИНН: String(12)",
            "Дата: Date"
          ]
        },
        {
          "type": "Catalog",
          "name": "Номенклатура"
        },
        {
          "type": "Enum",
          "name": "Статусы",
          "values": [
            "Новый",
            "Закрыт"
          ]
        },
        {
          "type": "Document",
          "name": "Расход",
          "attributes": [
            "Контрагент: CatalogRef.Контрагенты",
            "Статус: EnumRef.Статусы"
          ],
          "tabularSections": {
            "Товары": [
              "Количество: Number(15,3)"
            ]
          }
        }
      ],
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputDir": "{workDir}"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Documents/Расход.xml",
        "-FormName": "СвоиПоля",
        "-Purpose": "List"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
      "input": {
        "elements": [
          {
            "table": "Список",
            "path": "Список",
            "columns": [
              {
                "input": "СписокСсылка",
                "path": "Список.Ссылка"
              },
              {
                "input": "СписокПоле",
                "path": "Список.Поле"
              }
            ]
          }
        ],
        "attributes": [
          {
            "name": "Список",
            "type": "DynamicList",
            "main": true,
            "settings": {
              "mainTable": "Document.Расход",
              "query": "ВЫБРАТЬ Д.Ссылка КАК Ссылка, Д.Контрагент КАК Поле ИЗ Документ.Расход КАК Д ГДЕ Д.Проведен"
            }
          }
        ]
      },
      "args": {
        "-JsonPath": "{inputFile}",
        "-OutputPath": "{workDir}/Documents/Расход/Forms/СвоиПоля/Ext/Form.xml"
      }
    },
    {
      "script": "form-add/scripts/form-add",
      "args": {
        "-ObjectPath": "{workDir}/Documents/Расход.xml",
        "-FormName": "ТЧСоединение",
        "-Purpose": "List"
      }
    },
    {
      "script": "form-compile/scripts/form-compile",
