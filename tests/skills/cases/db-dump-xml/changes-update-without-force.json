{
  "name": "Changes по прошлой выгрузке: -update без -force",
  "fakePlatform": {
    "log": ""
  },
  "preRun": [
    {
      "writeFile": {
        "path": "out/ConfigDumpInfo.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ConfigDumpInfo format=\"Hierarchical\" version=\"2.17\"/>"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{fakePlatform}",
    "-InfoBasePath",
    "{workDir}/ib",
    "-ConfigDir",
    "{workDir}/out",
    "-Mode",
    "Changes"
  ],
  "expect": {
    "stdoutContains": [
      "Executing incremental configuration dump...",
      "-update"
    ],
    "stdoutNotContains": "-force"
  },
  "noSnapshot": "проверяется командная строка платформы; каталог выгрузки — фикстура кейса"
}
